{
  "name": "wedding-card-studio",
  "version": "2.7.0",
  "description": "Professional Hindu Wedding Card Designer",
  "main": "main.js",
  "author": "Aakash",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "files": [
      "**/*",
      "assets/fonts/**/*",
      "node_modules/@imgly/background-removal-node/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
     "asarUnpack": [
    "node_modules/@imgly/background-removal-node/**",
    "node_modules/onnxruntime-node/**"
  ]
  },
  "appId": "com.aakash.weddingstudio",
  "productName": "Wedding Card Studio",
  "artifactName": "Wedding-Card-Studio-Setup-${version}.${ext}",
  "publish": [
    {
      "provider": "github",
      "owner": "betheaakashhh",
      "repo": "weddingcardmaker"
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "icon.ico",
    "artifactName": "Wedding-Card-Studio-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "electron-updater": "^6.8.3",
    "fs": "^0.0.1-security"
  }
}
